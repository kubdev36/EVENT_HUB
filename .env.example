# Mẫu biến môi trường cho docker-compose.yml.
# Sao chép thành file .env (đã có trong .gitignore) rồi điền giá trị thật. Không commit file .env.

DB_USERNAME=event_hub
# Mật khẩu mạnh, ví dụ tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=
DB_NAME=event_hub
# Cổng Postgres mở cho máy local (chỉ 127.0.0.1)
DB_EXPOSE_PORT=5432

# Ít nhất 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Tài khoản admin tạo ở lần chạy đầu. Sau khi đăng nhập và đổi mật khẩu, để trống hai dòng này.
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# Domain frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Khóa mã hóa token Telegram trong DB: 32 byte base64, bắt buộc ở production.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mất khóa thì phải nhập lại token Telegram trong Cài đặt.
SETTINGS_ENC_KEY=

# Thư mục lưu ảnh thu nhỏ (mặc định ./storage/images trong event_hub_be)
IMAGE_STORE_DIR=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
